def clone(value):
    return copy.deepcopy(value)


# --- document -----------------------------------------------------------

class Document:
    """The config plus undo history and change notification."""

    def __init__(self, path=None):
        self.path = path or C.config_path()
        self.config, self.problems = C.load(self.path)
        self._undo = []
        self._redo = []
        self.dirty = False
        self._listeners = []

    def connect(self, callback):
        self._listeners.append(callback)

    def _notify(self, structural=True):
        for callback in self._listeners:
            callback(structural)

    def snapshot(self):
        self._undo.append(json.dumps(self.config))
        del self._undo[:-60]
        self._redo.clear()

    def changed(self, structural=True):
        self.dirty = True
        self._notify(structural)

    def undo(self):
        if not self._undo:
            return False
        self._redo.append(json.dumps(self.config))
        self.config = json.loads(self._undo.pop())
        self.dirty = True
        self._notify(True)
        return True

    def redo(self):
        if not self._redo:
            return False
        self._undo.append(json.dumps(self.config))
        self.config = json.loads(self._redo.pop())
        self.dirty = True
        self._notify(True)
        return True

    def save(self):
        C.save(self.config, self.path)
        self.dirty = False
        self._notify(False)
        return self.path

    # -- page/widget helpers -------------------------------------------

    def pages(self):
        return self.config.setdefault('pages', [])

    def page(self, page_id):
        for page in self.pages():
            if page.get('id') == page_id:
                return page
        return self.pages()[0] if self.pages() else None

    def find(self, widget_id):
        return C.find_widget(self.config, widget_id)

    def add_widget(self, page_id, lane, spec, index=None):
        page = self.page(page_id)
        spec = clone(spec)
        spec['id'] = C.new_id(spec['type'][:3])
        items = page.setdefault(lane, [])
        items.insert(len(items) if index is None else index, spec)
        return spec['id']

    def remove_widget(self, widget_id):
        page, lane, index, _ = self.find(widget_id)
        if page is None:
            return False
        page[lane].pop(index)
        return True

    def move_widget(self, widget_id, lane, index):
        page, old_lane, old_index, spec = self.find(widget_id)
        if page is None:
            return False
        page[old_lane].pop(old_index)
        if lane == old_lane and index > old_index:
            index -= 1
        target = page.setdefault(lane, [])
        target.insert(max(0, min(index, len(target))), spec)
        return True

    def duplicate_widget(self, widget_id):
        page, lane, index, spec = self.find(widget_id)
        if page is None:
            return None
        copy_spec = clone(spec)
        copy_spec['id'] = C.new_id(spec['type'][:3])
        page[lane].insert(index + 1, copy_spec)
        return copy_spec['id']


# --- preview ------------------------------------------------------------

class StripPreview(Gtk.DrawingArea):
    """The strip, drawn with the daemon's own renderer, and draggable."""

    def __init__(self, window):
        super().__init__()
        self.window = window
        self.zoom = 0.0                 # 0 = fit to width
        self.widgets = []
        self.drag_id = None
        self.drag_pos = None
        self.drop_hint = None
        self.set_content_height(int(W.STRIP_H * 0.9))
        self.set_hexpand(True)
        self.set_draw_func(self._draw)

        click = Gtk.GestureClick()
        click.connect('pressed', self._on_press)
        self.add_controller(click)

        drag = Gtk.GestureDrag()
        drag.connect('drag-begin', self._on_drag_begin)
        drag.connect('drag-update', self._on_drag_update)
        drag.connect('drag-end', self._on_drag_end)
        self.add_controller(drag)

        motion = Gtk.EventControllerMotion()
        motion.connect('motion', self._on_motion)
        self.add_controller(motion)
        self._hover = None

    # -- geometry -------------------------------------------------------

    def scale(self):
        if self.zoom > 0:
            return self.zoom
        width = max(200, self.get_width())
        return width / W.STRIP_W

    def strip_point(self, x, y):
        scale = self.scale()
        return x / scale, y / scale

    def update_height(self):
        self.set_content_height(max(40, int(W.STRIP_H * self.scale())))
        if self.zoom > 0:
            self.set_size_request(int(W.STRIP_W * self.zoom), -1)
        else:
            self.set_size_request(-1, -1)

    # -- drawing --------------------------------------------------------

    def _draw(self, area, ctx, width, height, *_):
        window = self.window
        scale = self.scale()
        ctx.save()
        ctx.scale(scale, scale)
        env = window.env(selected_id=window.selected_id)
        page = window.current_page()
        if page is None:
            ctx.restore()
            return
        self.widgets = W.render_page(ctx, window.doc.config, page, env)

        if self.drag_id and self.drop_hint:
            lane, x_pos = self.drop_hint
            T.set_source(ctx, T.parse_color('#4c8dff'))
            ctx.rectangle(x_pos - 1.5, 2, 3, W.STRIP_H - 4)
            ctx.fill()
        ctx.restore()

        # Lane guides while dragging, so "which group am I dropping into" is
        # answerable without reading any documentation.
        if self.drag_id:
            for i in range(1, 3):
                x_pos = width * i / 3
                ctx.set_source_rgba(1, 1, 1, 0.14)
                ctx.set_dash([4, 4])
                ctx.set_line_width(1)
                ctx.move_to(x_pos, 0)
                ctx.line_to(x_pos, height)
                ctx.stroke()
            ctx.set_dash([])

    # -- hit testing ----------------------------------------------------

    def widget_at(self, x, y):
        px, py = self.strip_point(x, y)
        for widget in self.widgets:
            if widget.contains(px, py) and widget.id != '__esc__':
                return widget
        return None

    def lane_at(self, x):
        third = max(1, self.get_width()) / 3
        return 'left' if x < third else ('center' if x < third * 2 else 'right')

    def insert_index(self, lane, x):
        px, _ = self.strip_point(x, 0)
        page = self.window.current_page() or {}
        specs = page.get(lane, [])
        index = 0
        for spec in specs:
            widget = next((w for w in self.widgets if w.id == spec.get('id')), None)
            if widget is None or spec.get('id') == self.drag_id:
                continue
            if px > widget.x + widget.w / 2:
                index += 1
        return index

    # -- input ----------------------------------------------------------

    def _on_press(self, gesture, n_press, x, y):
        widget = self.widget_at(x, y)
        self.window.select(widget.id if widget else None)

    def _on_motion(self, controller, x, y):
        widget = self.widget_at(x, y)
        new_hover = widget.id if widget else None
        if new_hover != self._hover:
            self._hover = new_hover
            self.set_cursor(Gdk.Cursor.new_from_name(
                'grab' if new_hover else 'default', None))

    def _on_drag_begin(self, gesture, x, y):
        widget = self.widget_at(x, y)
        self.drag_id = widget.id if widget else None
        self.drag_pos = (x, y)
        if self.drag_id:
            self.window.select(self.drag_id)
            self.set_cursor(Gdk.Cursor.new_from_name('grabbing', None))

    def _on_drag_update(self, gesture, dx, dy):
        if not self.drag_id or not self.drag_pos:
            return
        x = self.drag_pos[0] + dx
        lane = self.lane_at(x)
        index = self.insert_index(lane, x)
        page = self.window.current_page() or {}
        specs = [s for s in page.get(lane, []) if s.get('id') != self.drag_id]
        if index < len(specs):
            target = next((w for w in self.widgets
                           if w.id == specs[index].get('id')), None)
            hint_x = target.x - 3 if target else 0
        elif specs:
            target = next((w for w in self.widgets
                           if w.id == specs[-1].get('id')), None)
            hint_x = (target.x + target.w + 3) if target else 0
        else:
            hint_x = {'left': 120, 'center': W.STRIP_W / 2,
                      'right': W.STRIP_W - 120}[lane]
        self.drop_hint = (lane, hint_x)
        self.queue_draw()

    def _on_drag_end(self, gesture, dx, dy):
        if self.drag_id and self.drag_pos:
            x = self.drag_pos[0] + dx
            lane = self.lane_at(x)
            index = self.insert_index(lane, x)
            moved_id = self.drag_id
            self.drag_id = None
            self.drop_hint = None
            self.window.doc.snapshot()
            if self.window.doc.move_widget(moved_id, lane, index):
                self.window.doc.changed()
        self.drag_id = None
        self.drop_hint = None
        self.set_cursor(Gdk.Cursor.new_from_name('default', None))
        self.queue_draw()


# --- small reusable rows ------------------------------------------------

class IconButton(Gtk.Button):
    """Shows the chosen glyph and opens a picker."""

    def __init__(self, value, on_pick):
        super().__init__()
        self.on_pick = on_pick
        self.label = Gtk.Label(label=T.resolve_icon(value) or '—')
        self.label.add_css_class('nerd')
        self.set_child(self.label)
        self.set_valign(Gtk.Align.CENTER)
        self.set_tooltip_text('Choose an icon')
        self.connect('clicked', self._open)

    def set_value(self, value):
        self.label.set_label(T.resolve_icon(value) or '—')

    def _open(self, *_):
        popover = Gtk.Popover()
        popover.set_parent(self)
        scroller = Gtk.ScrolledWindow(min_content_height=320,
                                      min_content_width=380)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                           max_children_per_line=8, homogeneous=True,
                           row_spacing=4, column_spacing=4, margin_top=6,
                           margin_bottom=6, margin_start=6, margin_end=6)
        for name in sorted(T.ICONS):
            button = Gtk.Button(has_frame=False, tooltip_text=name)
            label = Gtk.Label(label=T.ICONS[name])
            label.add_css_class('nerd')
            button.set_child(label)
            button.connect('clicked', self._choose, name, popover)
            flow.append(button)
        clear = Gtk.Button(label='No icon', margin_top=4)
        clear.connect('clicked', self._choose, '', popover)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scroller.set_child(flow)
        box.append(scroller)
        box.append(clear)
        popover.set_child(box)
        popover.popup()

    def _choose(self, button, name, popover):
        self.set_value(name)
        self.on_pick(name)
        popover.popdown()


def color_button(hex_value, on_change):
    rgba = Gdk.RGBA()
    rgba.parse(hex_value if str(hex_value).startswith('#') else '#000000')
    dialog = Gtk.ColorDialog(with_alpha=False)
    button = Gtk.ColorDialogButton(dialog=dialog, rgba=rgba,
                                   valign=Gtk.Align.CENTER)

    def changed(btn, _param):
        colour = btn.get_rgba()
        on_change('#%02x%02x%02x' % (round(colour.red * 255),
                                     round(colour.green * 255),
                                     round(colour.blue * 255)))
    button.connect('notify::rgba', changed)
    return button


# --- main window --------------------------------------------------------

class EditorWindow(Adw.ApplicationWindow):
    def __init__(self, app, doc):
        super().__init__(application=app, title='Touch Bar')
        self.doc = doc
        self.doc.connect(self._on_doc_changed)
        self.selected_id = None
        self.page_id = doc.pages()[0]['id'] if doc.pages() else None
        self.client = dfripc.Client()
        self.live = False
        self._push_source = None
        self.session = Session(C.resolve_user())
        self.hub = FeedHub(self.session)

        self.set_default_size(1480, 880)
        self._build()
        self._refresh_all()
        self.select_first()

        GLib.timeout_add(250, self._tick)
        GLib.timeout_add_seconds(3, self._poll_daemon)

    # -- construction ---------------------------------------------------

    def _build(self):
        self.toasts = Adw.ToastOverlay()
        root = Adw.ToolbarView()
        self.toasts.set_child(root)
        self.set_content(self.toasts)

        header = Adw.HeaderBar()
        root.add_top_bar(header)

        self.page_dropdown = Gtk.DropDown.new_from_strings(['—'])
        self.page_dropdown.set_tooltip_text('Page being edited')
        self.page_dropdown.connect('notify::selected', self._on_page_selected)
        header.pack_start(self.page_dropdown)

        add_page = Gtk.Button(icon_name='list-add-symbolic',
                              tooltip_text='New page')
        add_page.connect('clicked', self._on_add_page)
        header.pack_start(add_page)

        page_menu = Gtk.MenuButton(icon_name='view-more-symbolic',
                                   tooltip_text='Page options')
        page_menu.set_popover(self._page_popover())
        header.pack_start(page_menu)

        self.view_switcher = Adw.ViewSwitcher(policy=Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(self.view_switcher)

        self.save_button = Gtk.Button(label='Save')
        self.save_button.add_css_class('suggested-action')
        self.save_button.connect('clicked', lambda *_: self.save())
        header.pack_end(self.save_button)

        self.live_toggle = Gtk.ToggleButton(label='Live')
        self.live_toggle.set_tooltip_text(
            'Push every edit to the running daemon without saving')
        self.live_toggle.connect('toggled', self._on_live_toggled)
        header.pack_end(self.live_toggle)

        menu_button = Gtk.MenuButton(icon_name='open-menu-symbolic')
        menu = Gtk.PopoverMenu()
        model = Gtk.Builder.new_from_string(MENU_XML, -1).get_object('app-menu')
        menu.set_menu_model(model)
        menu_button.set_popover(menu)
        header.pack_end(menu_button)

        self.status_icon = Gtk.Label(label='●')
        self.status_icon.add_css_class('status-dot-off')
        self.status_label = Gtk.Label(label='daemon offline')
        self.status_label.add_css_class('dim-label-small')
        status_box = Gtk.Box(spacing=6)
        status_box.append(self.status_icon)
        status_box.append(self.status_label)
        header.pack_end(status_box)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.set_content(content)

        self.banner = Adw.Banner(revealed=False)
        self.banner.connect('button-clicked', self._on_banner_action)
        content.append(self.banner)

        content.append(self._build_preview())

        self.stack = Adw.ViewStack(vexpand=True)
        self.view_switcher.set_stack(self.stack)
        self.stack.add_titled_with_icon(self._build_layout_view(), 'layout',
                                        'Layout', 'view-grid-symbolic')
        self.stack.add_titled_with_icon(self._build_theme_view(), 'theme',
                                        'Theme', 'applications-graphics-symbolic')
        self.stack.add_titled_with_icon(self._build_settings_view(), 'settings',
                                        'Settings', 'preferences-system-symbolic')
        content.append(self.stack)

        self._install_shortcuts()

    def _build_preview(self):
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                        margin_top=12, margin_bottom=8, margin_start=14,
                        margin_end=14)

        holder = Gtk.Box()
        holder.add_css_class('strip-frame')
        self.preview_scroller = Gtk.ScrolledWindow(
            hscrollbar_policy=Gtk.PolicyType.AUTOMATIC,
            vscrollbar_policy=Gtk.PolicyType.NEVER, hexpand=True)
        self.preview = StripPreview(self)
        self.preview_scroller.set_child(self.preview)
        holder.append(self.preview_scroller)
        frame.append(holder)

        bar = Gtk.Box(spacing=8)
        hint = Gtk.Label(label='Click to select · drag to rearrange · '
                               'the three zones are left, centre and right')
        hint.add_css_class('dim-label-small')
        hint.set_hexpand(True)
        hint.set_xalign(0.0)
        bar.append(hint)

        bar.append(Gtk.Label(label='Zoom', css_classes=['dim-label-small']))
        self.zoom_scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 0.35, 1.5, 0.05)
        self.zoom_scale.set_value(0.6)
        self.zoom_scale.set_draw_value(False)
        self.zoom_scale.add_css_class('zoom-scale')
        self.zoom_scale.connect('value-changed', self._on_zoom)
        bar.append(self.zoom_scale)
        fit = Gtk.Button(label='Fit')
        fit.connect('clicked', self._on_fit)
        bar.append(fit)
        frame.append(bar)
        return frame

    def _build_layout_view(self):
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL,
                          position=430, shrink_start_child=False,
                          shrink_end_child=False)
        paned.set_start_child(self._build_palette())
        self.property_scroller = Gtk.ScrolledWindow(hexpand=True)
        self.property_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.property_scroller.set_child(self.property_box)
        paned.set_end_child(self.property_scroller)
        return paned

    def _build_palette(self):
        page = Adw.PreferencesPage()
        by_category = {}
        for type_, cls in W.WIDGET_TYPES.items():
            if type_ == 'esc':
                continue                        # reserved, not placeable
            by_category.setdefault(cls.CATEGORY, []).append((type_, cls))
        for category in W.PALETTE_ORDER + sorted(set(by_category) - set(W.PALETTE_ORDER)):
            if category not in by_category:
                continue
            group = Adw.PreferencesGroup(title=category)
            for type_, cls in sorted(by_category[category], key=lambda p: p[1].LABEL):
                row = Adw.ActionRow(title=cls.LABEL, subtitle=cls.DESCRIPTION,
                                    activatable=True)
                row.add_css_class('palette-row')
                glyph = Gtk.Label(label=T.resolve_icon(cls.ICON))
                glyph.add_css_class('nerd')
                row.add_prefix(glyph)
                plus = Gtk.Image.new_from_icon_name('list-add-symbolic')
                row.add_suffix(plus)
                row.connect('activated', self._on_add_widget, type_)
                group.add(row)
            page.add(group)
        scroller = Gtk.ScrolledWindow()
        scroller.set_child(page)
        return scroller

    def _build_theme_view(self):
        self.theme_page = Adw.PreferencesPage()
        scroller = Gtk.ScrolledWindow()
        scroller.set_child(self.theme_page)
        return scroller

    def _build_settings_view(self):
        self.settings_page = Adw.PreferencesPage()
        scroller = Gtk.ScrolledWindow()
        scroller.set_child(self.settings_page)
        return scroller

    def _install_shortcuts(self):
        controller = Gtk.EventControllerKey()

        def on_key(_c, keyval, _code, state):
            ctrl = state & Gdk.ModifierType.CONTROL_MASK
            shift = state & Gdk.ModifierType.SHIFT_MASK
            name = Gdk.keyval_name(keyval)
            if ctrl and name in ('s', 'S'):
                self.save()
                return True
            if ctrl and name in ('z', 'Z'):
                (self.doc.redo if shift else self.doc.undo)()
                return True
            if ctrl and name in ('y', 'Y'):
                self.doc.redo()
                return True
            if ctrl and name in ('d', 'D'):
                self._duplicate_selected()
                return True
            if name in ('Delete', 'BackSpace') and self.selected_id:
                self._delete_selected()
                return True
            return False

        controller.connect('key-pressed', on_key)
        self.add_controller(controller)

    # -- state ----------------------------------------------------------

    def theme(self):
        return T.Theme(self.doc.config.get('theme'))

    def env(self, **kw):
        return W.Env(self.theme(), self.hub, self.doc.config, self.page_id,
                     preview=True, **kw)

    def current_page(self):
        return self.doc.page(self.page_id)

    def select_first(self):
        """Land on something selected: an empty inspector teaches nothing."""
        page = self.current_page() or {}
        for lane in C.LANES:
            if page.get(lane):
                self.select(page[lane][0]['id'])
                return
        self.select(None)

    def select(self, widget_id):
        self.selected_id = widget_id
        self._rebuild_properties()
        self.preview.queue_draw()

    # -- reactions ------------------------------------------------------

    def _on_doc_changed(self, structural):
        self._refresh_all()
        if self.live:
            self._schedule_push()

    def _refresh_all(self):
        pages = self.doc.pages()
        names = [p.get('name', p.get('id', '?')) for p in pages] or ['—']
        current = self.page_dropdown.get_selected()
        self.page_dropdown.set_model(Gtk.StringList.new(names))
        index = next((i for i, p in enumerate(pages) if p.get('id') == self.page_id), 0)
        self.page_dropdown.set_selected(index if index < len(names) else 0)
        if pages and (self.page_id is None or
                      not any(p.get('id') == self.page_id for p in pages)):
            self.page_id = pages[0]['id']
        self.save_button.set_label('Save*' if self.doc.dirty else 'Save')
        self._rebuild_properties()
        self._rebuild_theme_page()
        self._rebuild_settings_page()
        self.preview.queue_draw()

    def _tick(self):
        self.hub.pump()
        self.preview.queue_draw()
        return True

    def _poll_daemon(self):
        status = self.client.status() if self.client.available() else \
            {'ok': False, 'error': 'not running'}
        online = bool(status.get('ok'))
        self.status_icon.remove_css_class('status-dot-on' if not online
                                          else 'status-dot-off')
        self.status_icon.add_css_class('status-dot-on' if online
                                       else 'status-dot-off')
        if online:
            self.status_label.set_label(
                f"daemon on {status.get('page_name', '?')}"
                + (' · preview' if status.get('preview') else ''))
            self.banner.set_revealed(False)
        else:
            self.status_label.set_label('daemon offline')
            self.banner.set_title(
                'The Touch Bar daemon is not running — edits here are '
                'previewed in this window only.')
            self.banner.set_button_label('How to start it')
            self.banner.set_revealed(True)
        return True

    def _on_banner_action(self, *_):
        self._show_command_dialog(
            'Start the Touch Bar',
            'The daemon needs root to own the DRM node and /dev/uinput.\n'
            'Run this in a terminal:',
            'sudo systemctl start dfrd    # or: sudo ~/src/dfrd/dfrd')

    def _show_command_dialog(self, title, body, command):
        dialog = Adw.AlertDialog(heading=title, body=body)
        entry = Gtk.Entry(text=command, editable=False, hexpand=True)
        entry.add_css_class('monospace')
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(entry)
        copy = Gtk.Button(label='Copy command')

        def do_copy(*_):
            self.get_clipboard().set(command)
            self.toast('Command copied')
        copy.connect('clicked', do_copy)
        box.append(copy)
        dialog.set_extra_child(box)
        dialog.add_response('close', 'Close')
        dialog.present(self)

    def toast(self, message):
        self.toasts.add_toast(Adw.Toast(title=message, timeout=3))

    # -- live push ------------------------------------------------------

    def _on_live_toggled(self, button):
        self.live = button.get_active()
        if self.live:
            reply = self.client.ping()
            if not reply.get('ok'):
                self.toast('Daemon is not running — Live has nothing to talk to')
                button.set_active(False)
                return
            self._push_live()
        else:
            self.client.clear_preview()
            self.toast('Live preview off — the daemon is back on its saved config')

    def _schedule_push(self):
        if self._push_source:
            GLib.source_remove(self._push_source)
        self._push_source = GLib.timeout_add(180, self._push_live)

    def _push_live(self):
        self._push_source = None
        if self.live:
            reply = self.client.preview(self.doc.config, self.page_id)
            if not reply.get('ok'):
                self.toast(f"Live push failed: {reply.get('error')}")
        return False

    # -- page actions ---------------------------------------------------

    def _on_page_selected(self, dropdown, _param):
        pages = self.doc.pages()
        index = dropdown.get_selected()
        if 0 <= index < len(pages):
            self.page_id = pages[index]['id']
            self.select_first()
            self.preview.queue_draw()
            if self.live:
                self._schedule_push()

    def _page_popover(self):
        popover = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                      margin_top=8, margin_bottom=8, margin_start=8, margin_end=8)

        name_entry = Gtk.Entry(placeholder_text='Page name')
        box.append(name_entry)

        def rename(*_):
            page = self.current_page()
            text = name_entry.get_text().strip()
            if page and text:
                self.doc.snapshot()
                page['name'] = text
                self.doc.changed()
                self.toast(f'Page renamed to {text}')
                popover.popdown()
        rename_btn = Gtk.Button(label='Rename page')
        rename_btn.connect('clicked', rename)
        box.append(rename_btn)

        def refresh_entry(*_):
            page = self.current_page()
            name_entry.set_text(page.get('name', '') if page else '')
        popover.connect('show', refresh_entry)

        for label, direction in (('Move page left', -1), ('Move page right', +1)):
            button = Gtk.Button(label=label)
            button.connect('clicked', self._on_move_page, direction, popover)
            box.append(button)

        duplicate = Gtk.Button(label='Duplicate page')
        duplicate.connect('clicked', self._on_duplicate_page, popover)
        box.append(duplicate)

        delete = Gtk.Button(label='Delete page')
        delete.add_css_class('destructive-action')
        delete.connect('clicked', self._on_delete_page, popover)
        box.append(delete)

        popover.set_child(box)
        return popover

    def _on_move_page(self, button, direction, popover):
        pages = self.doc.pages()
        index = next((i for i, p in enumerate(pages)
                      if p.get('id') == self.page_id), None)
        if index is None:
            return
        target = max(0, min(len(pages) - 1, index + direction))
        if target == index:
            return
        self.doc.snapshot()
        pages.insert(target, pages.pop(index))
        self.doc.changed()
        popover.popdown()

    def _on_duplicate_page(self, button, popover):
        page = self.current_page()
        if page is None:
            return
        self.doc.snapshot()
        copy_page = clone(page)
        copy_page['id'] = C.new_id('page')
        copy_page['name'] = f"{page.get('name', 'Page')} copy"
        for lane in C.LANES:
            for spec in copy_page.get(lane, []):
                spec['id'] = C.new_id(spec['type'][:3])
        self.doc.pages().append(copy_page)
        self.page_id = copy_page['id']
        self.doc.changed()
        popover.popdown()
        self.toast('Page duplicated')

    def _on_delete_page(self, button, popover):
        pages = self.doc.pages()
        popover.popdown()
        if len(pages) <= 1:
            self.toast('The last page cannot be deleted')
            return
        page = self.current_page()
        dialog = Adw.AlertDialog(
            heading=f"Delete {page.get('name', 'this page')}?",
            body='Its widgets go with it. Ctrl+Z brings them back.')
        dialog.add_response('cancel', 'Cancel')
        dialog.add_response('delete', 'Delete')
        dialog.set_response_appearance('delete', Adw.ResponseAppearance.DESTRUCTIVE)

        def answered(_d, response):
            if response != 'delete':
                return
            self.doc.snapshot()
            pages.remove(page)
            self.page_id = pages[0]['id']
            self.selected_id = None
            self.doc.changed()
        dialog.connect('response', answered)
        dialog.present(self)

    def _on_add_page(self, *_):
        self.doc.snapshot()
        page = {'id': C.new_id('page'), 'name': f'Page {len(self.doc.pages()) + 1}',
                'icon': 'pages', 'left': [], 'center': [], 'right': []}
        self.doc.pages().append(page)
        self.page_id = page['id']
        self.doc.changed()
        self.toast('Page added')

    def _on_add_widget(self, row, type_):
        page = self.current_page()
        if page is None:
            return
        lane = 'center'
        if self.selected_id:
            _, selected_lane, _, _ = self.doc.find(self.selected_id)
            lane = selected_lane or lane
        self.doc.snapshot()
        new_id = self.doc.add_widget(self.page_id, lane, W.defaults_for(type_))
        self.selected_id = new_id
        self.doc.changed()
        self.toast(f'{W.WIDGET_TYPES[type_].LABEL} added to {LANE_LABELS[lane]}')

    def _delete_selected(self):
        if not self.selected_id:
            return
        self.doc.snapshot()
        if self.doc.remove_widget(self.selected_id):
            self.selected_id = None
            self.doc.changed()
            self.toast('Widget removed')

    def _duplicate_selected(self):
        if not self.selected_id:
            return
        self.doc.snapshot()
        new_id = self.doc.duplicate_widget(self.selected_id)
        if new_id:
            self.selected_id = new_id
            self.doc.changed()

    def save(self):
        path = self.doc.save()
        self.toast(f'Saved to {path}')
        reply = self.client.reload()
        if reply.get('ok'):
            self.live_toggle.set_active(False)
        self._refresh_all()

    def _on_zoom(self, scale):
        self.preview.zoom = scale.get_value()
        self.preview.update_height()
        self.preview.queue_draw()

    def _on_fit(self, *_):
        self.preview.zoom = 0.0
        self.preview.update_height()
        self.preview.queue_draw()

    # -- property panel --------------------------------------------------

