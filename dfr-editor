class EditorApp(Adw.Application):
    def __init__(self, options=None):
        super().__init__(application_id=APP_ID)
        self.options = options
        self.window = None

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        if self.window is None:
            doc = Document(getattr(self.options, 'config', None))
            self.window = EditorWindow(self, doc)
            self._install_actions(self.window, doc)
            view = getattr(self.options, 'view', 'layout')
            if view != 'layout':
                self.window.stack.set_visible_child_name(view)
        self.window.present()

    def _install_actions(self, window, doc):
        from gi.repository import Gio

        def add(name, callback):
            action = Gio.SimpleAction.new(name, None)
            action.connect('activate', callback)
            window.add_action(action)

        add('undo', lambda *_: doc.undo())
        add('redo', lambda *_: doc.redo())
        add('reload', lambda *_: window.toast(
            str(window.client.reload().get('error', 'daemon reloaded'))))

        def reset(*_):
            dialog = Adw.AlertDialog(
                heading='Reset to defaults?',
                body='Your pages, theme and settings will be replaced by the '
                     'stock layout. This can be undone with Ctrl+Z.')
            dialog.add_response('cancel', 'Cancel')
            dialog.add_response('reset', 'Reset')
            dialog.set_response_appearance('reset', Adw.ResponseAppearance.DESTRUCTIVE)

            def answered(_d, response):
                if response == 'reset':
                    doc.snapshot()
                    doc.config = C.default_config()
                    doc.changed()
            dialog.connect('response', answered)
            dialog.present(window)
        add('reset', reset)


def parse_args(argv):
    import argparse
    parser = argparse.ArgumentParser(
        prog='dfr-editor', description='Design your Touch Bar')
    parser.add_argument('--config', help='config file to edit')
    parser.add_argument('--view', choices=['layout', 'theme', 'settings'],
                        default='layout', help='which view to open on')
    return parser.parse_known_args(argv[1:])[0]


if __name__ == '__main__':
    OPTIONS = parse_args(sys.argv)
    sys.exit(EditorApp(OPTIONS).run([sys.argv[0]]))
