        if spec['type'] not in ('spacer', 'label'):
            page.add(self._build_action_group(spec, 'action', 'On tap'))
            page.add(self._build_action_group(spec, 'long_action',
                                              'On long press'))

        danger = Adw.PreferencesGroup()
        page.add(danger)
        duplicate = Adw.ActionRow(title='Duplicate', activatable=True,
                                  subtitle='Ctrl+D')
        duplicate.connect('activated', lambda *_: self._duplicate_selected())
        danger.add(duplicate)
        delete = Adw.ActionRow(title='Remove widget', activatable=True,
                               subtitle='Delete')
        delete.add_css_class('error')
        delete.connect('activated', lambda *_: self._delete_selected())
        danger.add(delete)

    def _build_field_row(self, spec, field, widget):
        key, kind = field['key'], field['kind']
        title = field['label']
        value = spec.get('props', {}).get(key, field.get('default'))
        help_text = field.get('help', '')

        def commit(new_value):
            self.doc.snapshot()
            spec.setdefault('props', {})[key] = new_value
            self.doc.changed(False)

        if kind == 'bool':
            row = Adw.SwitchRow(title=title, subtitle=help_text)
            row.set_active(bool(value))
            row.connect('notify::active',
                        lambda r, _p: commit(r.get_active()))
            return row

        if kind == 'choice':
            options = field.get('options', [])
            row = Adw.ComboRow(title=title, subtitle=help_text)
            row.set_model(Gtk.StringList.new([str(o) for o in options]))
            if value in options:
                row.set_selected(options.index(value))
            row.connect('notify::selected',
                        lambda r, _p: commit(options[r.get_selected()]))
            return row

        if kind in ('int', 'float'):
            step = field.get('step', 1 if kind == 'int' else 0.05)
            row = Adw.SpinRow.new_with_range(field.get('min', 0),
                                             field.get('max', 1000), step)
            row.set_title(title)
            if help_text:
                row.set_subtitle(help_text)
            if kind == 'float':
                row.set_digits(2)
            row.set_value(float(value or 0))
            row.connect('notify::value',
                        lambda r, _p: commit(r.get_value() if kind == 'float'
                                             else int(r.get_value())))
            return row

        if kind == 'icon':
            row = Adw.EntryRow(title=title)
            row.set_text(str(value or ''))
            picker = IconButton(value, lambda name: (row.set_text(name),
                                                     commit(name)))
            row.add_suffix(picker)
            row.connect('changed', lambda r: commit(r.get_text()))
            return row

        if kind == 'file':
            row = Adw.EntryRow(title=title)
            row.set_text(str(value or ''))
            browse = Gtk.Button(icon_name='document-open-symbolic',
                                valign=Gtk.Align.CENTER)

            def choose(*_):
                dialog = Gtk.FileDialog(title='Choose an image')

                def done(dlg, result):
                    try:
                        chosen = dlg.open_finish(result)
                    except GLib.Error:
                        return
                    if chosen:
                        row.set_text(chosen.get_path())
                dialog.open(self, None, done)
            browse.connect('clicked', choose)
            row.add_suffix(browse)
            row.connect('changed', lambda r: commit(r.get_text()))
            return row

        if kind == 'page':
            pages = self.doc.pages()
            ids = [p['id'] for p in pages]
            row = Adw.ComboRow(title=title, subtitle=help_text)
            row.set_model(Gtk.StringList.new([p.get('name', p['id'])
                                              for p in pages]))
            if value in ids:
                row.set_selected(ids.index(value))
            row.connect('notify::selected',
                        lambda r, _p: commit(ids[r.get_selected()]))
            return row

        row = Adw.EntryRow(title=title)
        row.set_text('' if value is None else str(value))
        row.connect('changed', lambda r: commit(r.get_text()))
        return row

    def _build_action_group(self, spec, key, title):
        """One group: what kind of action, plus that kind's own fields.

        The detail rows are rebuilt in place whenever the kind changes, so the
        panel only ever shows fields that mean something for the current
        choice -- no empty "URL" box under a key binding.
        """
        group = Adw.PreferencesGroup(title=title)
        types = A.ACTION_TYPES
        action = spec.get(key) or {'type': 'none'}

        combo = Adw.ComboRow(title='Action')
        combo.set_model(Gtk.StringList.new([A.ACTION_LABELS[t] for t in types]))
        combo.set_selected(types.index(action['type'])
                           if action.get('type') in types else 0)
        group.add(combo)

        detail_rows = []
        building = {'first': True}

        def commit(new_action):
            spec[key] = new_action
            # The first build just reflects what is already stored; marking the
            # document dirty there would show unsaved changes the moment a
            # widget is selected.
            if not building['first']:
                self.doc.changed(False)

        def clear_rows():
            while detail_rows:
                group.remove(detail_rows.pop())

        def add(row):
            group.add(row)
            detail_rows.append(row)

        def rebuild(*_):
            kind = types[combo.get_selected()]
            current = spec.get(key) or {}
            if current.get('type') != kind:
                current = {'type': kind}
                commit(current)
            clear_rows()

            if kind == 'key':
                row = Adw.EntryRow(title='Keys')
                row.set_text('+'.join(current.get('keys') or []))
                picker = Gtk.MenuButton(icon_name='view-list-symbolic',
                                        valign=Gtk.Align.CENTER,
                                        tooltip_text='Key catalogue')
                picker.set_popover(self._key_popover(row))
                row.add_suffix(picker)

                def on_keys(entry):
                    keys = [k.strip().upper() for k in
                            entry.get_text().replace(',', '+').split('+')
                            if k.strip()]
                    commit({'type': 'key', 'keys': keys})
                    unknown = [k for k in keys if di.keycode(k) is None]
                    entry.remove_css_class('error')
                    if unknown:
                        entry.add_css_class('error')
                        entry.set_tooltip_text('Unknown: ' + ', '.join(unknown))
                    else:
                        entry.set_tooltip_text(None)
                row.connect('changed', on_keys)
                add(row)

            elif kind == 'exec':
                row = Adw.EntryRow(title='Command')
                row.set_text(current.get('command', ''))
                row.connect('changed', lambda r: commit(
                    {'type': 'exec', 'command': r.get_text()}))
                add(row)

            elif kind == 'url':
                row = Adw.EntryRow(title='URL')
                row.set_text(current.get('url', ''))
                row.connect('changed', lambda r: commit(
                    {'type': 'url', 'url': r.get_text()}))
                add(row)

            elif kind == 'page':
                pages = self.doc.pages()
                targets = ['+1', '-1'] + [p['id'] for p in pages]
                labels = ['Next page', 'Previous page'] + \
                    [p.get('name', p['id']) for p in pages]
                row = Adw.ComboRow(title='Go to')
                row.set_model(Gtk.StringList.new(labels))
                target = current.get('page', '+1')
                row.set_selected(targets.index(target) if target in targets else 0)
                row.connect('notify::selected', lambda r, _p: commit(
                    {'type': 'page', 'page': targets[r.get_selected()]}))
                add(row)

            elif kind in ('volume', 'brightness'):
                if kind == 'volume':
                    mute = Adw.SwitchRow(title='Toggle mute instead of stepping')
                    mute.set_active(bool(current.get('toggle_mute')))
                    add(mute)
                step = Adw.SpinRow.new_with_range(-50, 50, 5)
                step.set_title('Change by')
                step.set_subtitle('percentage points')
                step.set_value(float(current.get('delta', 5)))
                add(step)

                def on_level(*_):
                    if kind == 'volume' and mute.get_active():
                        commit({'type': 'volume', 'toggle_mute': True})
                    else:
                        commit({'type': kind, 'delta': step.get_value()})
                step.connect('notify::value', on_level)
                if kind == 'volume':
                    mute.connect('notify::active', on_level)

            elif kind == 'hypr':
                row = Adw.EntryRow(title='Dispatch')
                row.set_text(current.get('dispatch', ''))
                row.set_tooltip_text(
                    'Lua form -- hyprctl rejects the legacy syntax here, so '
                    'use hl.dsp.focus({ workspace = "3" })')
                row.connect('changed', lambda r: commit(
                    {'type': 'hypr', 'dispatch': r.get_text()}))
                add(row)

            elif kind == 'mode':
                row = Adw.ActionRow(
                    title='Returns the strip to keyboard mode',
                    subtitle='Firmware keys come back and the daemon exits')
                add(row)

        combo.connect('notify::selected', rebuild)
        rebuild()
        building['first'] = False
        return group

    def _key_popover(self, entry_row):
        popover = Gtk.Popover()
        scroller = Gtk.ScrolledWindow(min_content_height=340,
                                      min_content_width=300)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                      margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        for group_name, names in di.KEY_GROUPS:
            label = Gtk.Label(label=group_name, xalign=0.0)
            label.add_css_class('heading')
            box.append(label)
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                               max_children_per_line=6, column_spacing=3,
                               row_spacing=3)
            for name in names:
                button = Gtk.Button(label=name, has_frame=False)
                button.add_css_class('dim-label-small')

                def pick(_b, key=name):
                    text = entry_row.get_text()
                    entry_row.set_text(f'{text}+{key}' if text else key)
                button.connect('clicked', pick)
                flow.append(button)
            box.append(flow)
        scroller.set_child(box)
        popover.set_child(scroller)
        return popover

    def _on_lane_changed(self, row, _param, widget_id):
        lane = list(C.LANES)[row.get_selected()]
        page, current_lane, _, _ = self.doc.find(widget_id)
        if current_lane == lane:
            return
        self.doc.snapshot()
        self.doc.move_widget(widget_id, lane, len(page.get(lane, [])))
        self.doc.changed()

    def _on_nudge(self, button, widget_id, direction):
        page, lane, index, _ = self.doc.find(widget_id)
        if page is None:
            return
        self.doc.snapshot()
        self.doc.move_widget(widget_id, lane, index + direction +
                             (1 if direction > 0 else 0))
        self.doc.changed()

    def _on_width_changed(self, row, _param, widget_id):
        _, _, _, spec = self.doc.find(widget_id)
        if spec is None:
            return
        value = int(row.get_value())
        if value <= 0:
            spec.pop('width', None)
        else:
            spec['width'] = value
        self.doc.changed(False)

    def _on_flex_changed(self, row, _param, widget_id):
        _, _, _, spec = self.doc.find(widget_id)
        if spec is None:
            return
        value = int(row.get_value())
        if value <= 0:
            spec.pop('flex', None)
        else:
            spec['flex'] = value
        self.doc.changed(False)

    # -- theme page ------------------------------------------------------

    def _rebuild_theme_page(self):
        page = self.theme_page
        for group in list(getattr(self, '_theme_groups', [])):
            page.remove(group)
        self._theme_groups = []

        theme_cfg = self.doc.config.setdefault('theme', {})
        resolved = T.Theme(theme_cfg)

        presets = Adw.PreferencesGroup(
            title='Palette',
            description='Start from a preset, then adjust any colour.')
        names = sorted(T.PRESETS)
        combo = Adw.ComboRow(title='Preset')
        combo.set_model(Gtk.StringList.new([n.title() for n in names]))
        current = theme_cfg.get('preset', 'midnight')
        if current in names:
            combo.set_selected(names.index(current))

        def apply_preset(row, _param):
            name = names[row.get_selected()]
            self.doc.snapshot()
            keep = {k: theme_cfg[k] for k in T.Theme.METRIC_KEYS + ('font', 'icon_font')
                    if k in theme_cfg}
            self.doc.config['theme'] = dict(T.PRESETS[name], preset=name, **keep)
            self.doc.changed()
        combo.connect('notify::selected', apply_preset)
        presets.add(combo)
        page.add(presets)
        self._theme_groups.append(presets)

        colours = Adw.PreferencesGroup(title='Colours')
        descriptions = {
            'background': 'The strip itself',
            'surface': 'Button and widget fills',
            'surface_alt': 'Secondary fills',
            'pressed': 'While a key is held',
            'text': 'Primary text',
            'text_dim': 'Labels and secondary text',
            'accent': 'Highlights, sliders, active page',
            'good': 'Positive values',
            'warn': 'Warnings',
            'bad': 'Negative values and alerts',
        }
        for key in T.Theme.COLOR_KEYS:
            row = Adw.ActionRow(title=key.replace('_', ' ').title(),
                                subtitle=descriptions.get(key, ''))
            hex_value = T.to_hex(getattr(resolved, key))

            def on_change(new_hex, key=key):
                self.doc.snapshot()
                theme_cfg[key] = new_hex
                theme_cfg['preset'] = 'custom'
                self.doc.changed(False)
            row.add_suffix(color_button(hex_value, on_change))
            colours.add(row)
        page.add(colours)
        self._theme_groups.append(colours)

        metrics = Adw.PreferencesGroup(title='Shape and type')
        specs = [
            ('radius', 'Corner radius', 0, 30, 1),
            ('gap', 'Gap between widgets', 0, 30, 1),
            ('padding', 'Edge padding', 0, 20, 1),
            ('label_size', 'Label size', 8, 34, 1),
            ('value_size', 'Value size', 8, 34, 1),
            ('icon_size', 'Icon size', 8, 40, 1),
        ]
        for key, title, low, high, step in specs:
            row = Adw.SpinRow.new_with_range(low, high, step)
            row.set_title(title)
            row.set_value(float(getattr(resolved, key)))

            def on_metric(row_widget, _param, key=key):
                self.doc.snapshot()
                theme_cfg[key] = row_widget.get_value()
                self.doc.changed(False)
            row.connect('notify::value', on_metric)
            metrics.add(row)

        for key, title in (('font', 'Text font'), ('icon_font', 'Icon font')):
            row = Adw.EntryRow(title=title)
            row.set_text(getattr(resolved, key))

            def on_font(entry, key=key):
                theme_cfg[key] = entry.get_text()
                self.doc.changed(False)
            row.connect('changed', on_font)
            metrics.add(row)
        page.add(metrics)
        self._theme_groups.append(metrics)

    # -- settings page ---------------------------------------------------

    def _rebuild_settings_page(self):
        page = self.settings_page
        for group in list(getattr(self, '_settings_groups', [])):
            page.remove(group)
        self._settings_groups = []
        settings = self.doc.config.setdefault('settings', {})

        def commit(key, value):
            self.doc.snapshot()
            settings[key] = value
            self.doc.changed(False)

        safety = Adw.PreferencesGroup(
            title='Safety',
            description='USB config 2 has no keyboard interface, so this '
                        'daemon is the only source of an Escape key while the '
                        'strip is in display mode.')
        esc = Adw.SwitchRow(title='Always reserve an Escape key',
                            subtitle='Drawn by the daemon on every page')
        esc.set_active(bool(settings.get('always_esc', True)))
        esc.connect('notify::active', lambda r, _p: commit('always_esc',
                                                           r.get_active()))
        safety.add(esc)

        esc_width = Adw.SpinRow.new_with_range(60, 200, 2)
        esc_width.set_title('Escape key width')
        esc_width.set_value(float(settings.get('esc_width', 92)))
        esc_width.connect('notify::value',
                          lambda r, _p: commit('esc_width', int(r.get_value())))
        safety.add(esc_width)

        revert = Adw.SwitchRow(
            title='Return to keyboard mode when the daemon stops',
            subtitle='Restores the firmware keys instead of leaving the strip dark')
        revert.set_active(bool(settings.get('revert_on_exit', True)))
        revert.connect('notify::active',
                       lambda r, _p: commit('revert_on_exit', r.get_active()))
        safety.add(revert)
        page.add(safety)
        self._settings_groups.append(safety)

        behaviour = Adw.PreferencesGroup(title='Behaviour')
        swipe = Adw.SwitchRow(title='Swipe to change page',
                              subtitle='Drag across the strip')
        swipe.set_active(bool(settings.get('swipe_pages', True)))
        swipe.connect('notify::active',
                      lambda r, _p: commit('swipe_pages', r.get_active()))
        behaviour.add(swipe)

        dim = Adw.SpinRow.new_with_range(0, 600, 10)
        dim.set_title('Blank after')
        dim.set_subtitle('Seconds of no touch. 0 keeps it lit.')
        dim.set_value(float(settings.get('dim_after', 0)))
        dim.connect('notify::value',
                    lambda r, _p: commit('dim_after', int(r.get_value())))
        behaviour.add(dim)
        page.add(behaviour)
        self._settings_groups.append(behaviour)

        calibration = Adw.PreferencesGroup(
            title='Touch calibration',
            description='Only needed if taps land on the wrong widget.')
        for key, title in (('flip_x', 'Flip horizontally'),
                           ('flip_y', 'Flip vertically')):
            row = Adw.SwitchRow(title=title)
            row.set_active(bool(settings.get(key)))
            row.connect('notify::active',
                        lambda r, _p, key=key: commit(key, r.get_active()))
            calibration.add(row)
        page.add(calibration)
        self._settings_groups.append(calibration)

        hardware = Adw.PreferencesGroup(
            title='Hardware',
            description='The strip must be in display mode for any of this to '
                        'reach the panel.')
        for label, subtitle, command in (
            ('Switch to display mode',
             'Hands the strip to dfrd. No Escape key until the daemon draws one.',
             'sudo dfrctl mode display'),
            ('Switch to keyboard mode',
             'Gives the firmware keys back.',
             'sudo dfrctl mode keyboard'),
        ):
            row = Adw.ActionRow(title=label, subtitle=subtitle, activatable=True)
            row.connect('activated', lambda _r, cmd=command, t=label:
                        self._show_command_dialog(t, 'Run this in a terminal:', cmd))
            hardware.add(row)
        page.add(hardware)
        self._settings_groups.append(hardware)


