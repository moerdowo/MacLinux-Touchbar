            return

        cls = W.WIDGET_TYPES.get(spec['type'], W.LabelWidget)
        widget = W.build(spec)

        general = Adw.PreferencesGroup(title=cls.LABEL,
                                       description=cls.DESCRIPTION)
        page.add(general)

        lane_row = Adw.ComboRow(title='Group',
                                subtitle='Which end of the strip it belongs to')
        lane_row.set_model(Gtk.StringList.new(
            [LANE_LABELS[lane_key] for lane_key in C.LANES]))
        lane_row.set_selected(list(C.LANES).index(lane))
        lane_row.connect('notify::selected', self._on_lane_changed, spec['id'])
        general.add(lane_row)

        order = Adw.ActionRow(title='Position',
                              subtitle=f'{index + 1} of {len(self.current_page()[lane])}')
        left_btn = Gtk.Button(icon_name='go-previous-symbolic',
                              valign=Gtk.Align.CENTER)
        right_btn = Gtk.Button(icon_name='go-next-symbolic',
                               valign=Gtk.Align.CENTER)
        left_btn.connect('clicked', self._on_nudge, spec['id'], -1)
        right_btn.connect('clicked', self._on_nudge, spec['id'], +1)
        order.add_suffix(left_btn)
        order.add_suffix(right_btn)
        general.add(order)

        width_row = Adw.SpinRow.new_with_range(0, 1200, 2)
        width_row.set_title('Width')
        width_row.set_subtitle('0 sizes it to its content')
        width_row.set_value(float(spec.get('width') or 0))
        width_row.connect('notify::value', self._on_width_changed, spec['id'])
        general.add(width_row)

        flex_row = Adw.SpinRow.new_with_range(0, 12, 1)
        flex_row.set_title('Stretch')
        flex_row.set_subtitle('Share of the leftover space (0 = fixed width)')
        flex_row.set_value(float(spec.get('flex') or 0))
        flex_row.connect('notify::value', self._on_flex_changed, spec['id'])
